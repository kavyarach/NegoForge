# NegoForge Environment Configuration Example
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_URL=http://localhost:5173

# Optional LLM Integration (If empty, system safely uses built-in rule-based reasoning engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Email Integration (If empty, system safely logs report generation & email status)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NegoForge <noreply@negoforge.com>
RESEND_API_KEY=
